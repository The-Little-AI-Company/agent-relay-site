---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Agent Relay — stop being the hallway",
  description = "Agent Relay moves work between people and AI agents without losing the source, limits, status, or receipt. Free and open source.",
} = Astro.props;

const site = Astro.site ?? new URL("https://the-little-ai-company.github.io");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const baseWithSlash = `${base}/`;
const routePath =
  base &&
  (Astro.url.pathname === base || Astro.url.pathname.startsWith(baseWithSlash))
    ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const canonicalPath = `${base}${routePath === "/" ? "/" : routePath}`;
const canonicalUrl = new URL(canonicalPath, site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href={`${base}/`}>
        <span class="brand-dot"></span>
        Agent Relay
      </a>
      <nav>
        <a href={`${base}/method/`}>Method</a>
        <a href="https://github.com/The-Little-AI-Company/open-work-relay" rel="noopener">GitHub</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <script>
      // Add a copy button to every code block. A `data-copy` attribute on the
      // <pre> overrides what gets copied (used by terminal blocks to copy clean
      // commands without the "$" prompts or output lines).
      document.querySelectorAll("pre").forEach((pre) => {
        const wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.textContent = "Copy";
        wrap.appendChild(btn);

        btn.addEventListener("click", async () => {
          const text = pre.dataset.copy || pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "Copied";
            btn.classList.add("copied");
            setTimeout(() => {
              btn.textContent = "Copy";
              btn.classList.remove("copied");
            }, 1500);
          } catch {
            btn.textContent = "Press ⌘/Ctrl+C";
          }
        });
      });
    </script>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>Agent Relay — the human should not be the hallway.</p>
        <p class="muted">
          MIT licensed. Free and open. Copy it, teach it, remix it.
        </p>
      </div>
    </footer>
  </body>
</html>
